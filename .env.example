# Só nomes de variáveis. Valores reais ficam no ambiente (Railway/GCP), nunca no repositório.
APP_PORT=
APP_BASE_URL=
APP_CORS_ALLOWED_ORIGINS=
SCORES_APP_VERSION=

# Perfis: dev (padrão, H2) | mysql,prod em produção (ProductionConfigGuard recusa subir com segredo vazio)
SPRING_PROFILES_ACTIVE=

# Banco (perfil mysql)
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=
MYSQL_POOL_SIZE=

# Sessão e tokens (RNF4): par RSA em PEM; vazio fora de prod => par efêmero
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_MINUTES=
JWT_REFRESH_TTL_DAYS=
SCORES_REFRESH_COOKIE_SECURE=
SCORES_REFRESH_IN_BODY=

# Criptografia de dados pessoais (RNF5): AES-256, Base64 de 32 bytes; vazio fora de prod => chave efêmera
DATA_ENCRYPTION_KEY=

# Limites e IP do cliente (RNF3): HMAC do IP assinado pelo BFF (o mesmo valor no servidor do front, nunca NEXT_PUBLIC_)
EDGE_PROXY_SECRET=
SCORES_CLIENT_IP_HEADER=
SCORES_HASH_MAX_CONCURRENT=

# Admin inicial (AdminBootstrap): só cria se não houver admin; senha de 12+ caracteres, só no gerenciador de segredos
SCORES_ADMIN_EMAIL=
SCORES_ADMIN_PASSWORD=
SCORES_ADMIN_PROMOTE_EXISTING=

# Links curtos de mídia privada (Meu jogador, bloco 9); exigido no perfil prod
MEDIA_LINK_SECRET=

# Adaptadores (memory/filesystem até o Redis e o S3 entrarem, D-8)
SCORES_PERSISTENCE_CACHE=
SCORES_PERSISTENCE_MEDIA=
SCORES_MEDIA_LOCAL_DIR=

# Frontend (públicas no navegador: nunca segredo aqui)
NEXT_PUBLIC_API_MODE=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Gate de dev do front (só no servidor do Next, nunca NEXT_PUBLIC_): o valor nasce no gerenciador de segredos, nunca no chat
DEV_GATE_SECRET=
DEV_GATE_ENABLED=
DEV_GATE_ALLOWED_EMAILS=
DEV_GATE_PIN_SHA=
DEV_GATE_TTL_HOURS=
DEV_GATE_REDIS_URL=
