@startuml
title RF1 — Cadastro de usuário · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "account" {
  class UserAccount {
    id: UUID
    email: String «AES-GCM»
    emailHash: String «unique»
    passwordHash: String «Argon2id»
    displayName: String
    locale: Locale
    role: Role
    status: AccountStatus
    failedLoginAttempts: int
    lockedUntil: Instant
    marketingConsent: boolean
    deletionRequestedAt: Instant
    profileVisibility: ProfileVisibility
    birthDate: LocalDate
    pendingEmail: String
  }
  class UserSettings {
    simQuarterMinutes: int
    playCallingLevel: PlayCallingLevel (KEY_MOMENTS|ALL_PLAYS|NONE)
    decisionTimeoutSeconds: int
    difficulty: Difficulty
    theme: ThemeMode
    highContrast: boolean
    fontScale: FontScale
    reducedMotion: boolean
    regionalFormat: String
    units: YardsOrMeters
    notificationsEnabled: boolean
  }
  class ConsentRecord {
    user: UserAccount
    purpose: ConsentPurpose
    granted: boolean
    textVersion: String
    source: ConsentSource
    ipHash: String
    recordedAt: Instant
  }
  class AuditLog {
    actor: String
    action: String
    resource: String
    resourceId: String
    result: String
    ip: String
    userAgent: String
    correlationId: String
    timestamp: Instant
  }
}
class RegisterUserUseCase <<UseCase>> {
  execute(RegisterCommand, ip): RegisterResult  «hash fora da TX, escrita curta»
}
class RegisterCommand <<record>> {
  email: String
  password: String
  displayName: String
  locale: UserLocale
  birthDate: LocalDate
  dataProcessingConsent: boolean
  marketingConsent: boolean
}
class PasswordHasher <<Service>> {
  permits: Semaphore
  hash(raw): String «Argon2id»
  verify(raw, hash): boolean
}
class ReservedNames <<Policy>> {
  isReserved(displayName): boolean
}
class AdminBootstrap <<Runner>> {
  run()  «só com SCORES_AF_ADMIN_EMAIL do cofre»
}
interface RateLimiterPort <<Port>> {
  tryAcquire(key, max, window): boolean
  release(key)
  reset(key)
}
interface EmailPort <<Port>> {
  send(to, template, vars) «e-mail mascarado no log»
}
UserAccount "1" -- "1" UserSettings : configurações
UserAccount "1" -- "*" ConsentRecord : consentimentos
RegisterUserUseCase ..> RegisterCommand : recebe
RegisterUserUseCase ..> PasswordHasher : hash fora da TX
RegisterUserUseCase ..> ReservedNames : usa
RegisterUserUseCase ..> UserAccount : cria
RegisterUserUseCase ..> UserSettings : cria padrão AF
RegisterUserUseCase ..> ConsentRecord : DATA_PROCESSING
RegisterUserUseCase ..> AuditLog : REGISTER «REQUIRES_NEW»
RegisterUserUseCase ..> EmailPort : verificação
AdminBootstrap ..> UserAccount : ADMIN inicial
@enduml
