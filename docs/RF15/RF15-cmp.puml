@startuml
title RF15 — Estilos de head coach por recompensa e Scores Points · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
actor "Agendador/Job assíncrono" as c2
package "Frontend (Next.js)" as pkg_fe {
  component "StorePage" as c3
  frame "componentes de StorePage" as pkg_fe_sub {
    component "CoachStyleCard" as c4
    component "StyleEffectsPopover" as c5
    component "ManagerPanelPage" as c6
    component "ActiveStyleSelector" as c7
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "StoreController" as c8
  component "ManagerController" as c9
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "ListStoreItemsUseCase" as c10
  component "PurchaseStoreItemUseCase" as c11
  component "ApplyCoachStyleUseCase" as c12
  component "ListGoalsUseCase" as c13
  component "GoalEvaluationJob" as c14
  component "CareerAccess" as c15
  component "AuditService" as c16
}
package "scores-af-domain/engine" as pkg_eng {
  component "MoraleEngine" as c17
  component "CoachStyleEffects" as c18
}
package "portas (port.out)" as pkg_ports {
  interface "StoreItemRepository" as c19
  interface "ManagerStyleRepository" as c20
  interface "PurchaseRepository" as c21
  interface "ManagerProfileRepository" as c22
  interface "CareerSaveRepository" as c23
  interface "GoalRepository" as c24
  interface "PointsTransactionRepository" as c25
  interface "WalletCachePort" as c26
  interface "AuditLogRepository" as c27
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c28
  component "cache-redis" as c29
}
database "MySQL 8" as s1
database "Redis 7" as s2
c1 --> c3 : usa
c2 --> c10 : dispara
c3 --> c8 : GET /store/items (alvo)\nPOST /store/purchase (alvo)\nGET /careers/{id}/goals (alvo)\n…
c3 --> c9
c8 --> c10
c9 --> c10
c10 ..> pkg_app : orquestra
c10 --> c17 : usa
c10 --> c18 : usa
pkg_app --> pkg_ports : depende (DIP)
c28 .up.|> c19
c28 .up.|> c20
c28 .up.|> c21
c28 .up.|> c22
c28 .up.|> c23
c28 .up.|> c24
c28 .up.|> c25
c29 .up.|> c26
c28 .up.|> c27
c28 --> s1
c29 --> s2
@enduml
