@startuml
title RF19 — Reforçar o elenco: free agency, trocas e waivers · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "career" {
  class CareerSave {
    id: UUID
    name: String
    seed: long
    employmentStatus: EmploymentStatus
    currentWeek: int
    difficulty: Difficulty
    seasonMode: SeasonMode
    scoresPoints: int
    status: SaveStatus
    slot: int
    lastPlayedAt: Instant
  }
}
package "season" {
  class Season {
    number: int
    year: int
    phase: SeasonPhase (PRESEASON|REGULAR|PLAYOFFS|DRAFT|FREE_AGENCY|OFFSEASON)
    currentWeek: int
    tradeDeadlineWeek: int
    championClub: Club?
    mvpPlayer: Player?
  }
}
package "catalog" {
  class Club {
    id: UUID
    name: String
    shortName: String
    city: String
    conference: Conference
    division: Division
    logoKey: String
    primaryColor: String
    secondaryColor: String
    accentColor: String
    prestige: int
    reputationBoard: int
    reputationFans: int
    cash: long
    capSpace: long
    isUserControlled: boolean
    expectedWins: int
    scoutingLevel: int
    scoutingBudget: long
  }
  class Player {
    id: UUID
    name: String
    nationality: String
    college: String
    birthDate: LocalDate
    age: int
    heightCm: int
    weightKg: int
    position: Position (QB|RB|FB|WR|TE|LT|LG|C|RG|RT|DE|DT|OLB|MLB|CB|FS|SS|K|P|LS)
    unit: Unit (OFFENSE|DEFENSE|SPECIAL)
    attributes: PlayerAttributes
    overall: int «por posição, OVR v1»
    potential: int
    experienceYears: int
    rosterStatus: RosterStatus (ACTIVE|INACTIVE|PRACTICE_SQUAD|IR|PUP|FREE_AGENT|WAIVED)
    condition: int
    morale: int
    moraleFactors: JSON
    injury: Injury?
    suspensionWeeks: int
    contract: PlayerContract
    jerseyNumber: int
    isLegendary: boolean
    model3dUrl: String
  }
}
package "market" {
  class PlayerContract {
    «embedded» years: int
    baseSalaryByYear: JSON
    signingBonus: long «rateado»
    guaranteed: long
    capHitByYear: JSON
    deadMoneyIfCut: long
    franchiseTag: boolean
    type: ContractType (ROOKIE|VETERAN|MINIMUM|TAG|PRACTICE)
    endSeason: int
  }
  class FreeAgentOffer {
    player: Player
    years: int
    totalValue: long
    guaranteed: long
    signingBonus: long
    status: OfferStatus
    phase: FAPhase (NEGOTIATION|OPEN|IN_SEASON)
    expiresAt: Instant
    playerInterest: int
  }
  class TradeProposal {
    playersOut: List<UUID>
    playersIn: List<UUID>
    picksOut: List<DraftPick>
    picksIn: List<DraftPick>
    capImpact: long
    status: OfferStatus
    reason: String
    beforeDeadline: boolean
  }
  class DraftPick {
    season: int (até 3 à frente)
    round: int (1–7)
    overall: Integer
    originalClub: Club
    ownerClub: Club
    compensatory: boolean
  }
  class WaiverClaim {
    player: Player
    claimingClub: Club
    priority: int «ordem inversa da classificação»
    status: ClaimStatus (PENDING|AWARDED|LOST)
    processedAt: Instant
  }
}
package "finance" {
  class SalaryCapLedger {
    season: int
    cap: long
    committed: long
    deadMoney: long
    space: long
    rolloverFromPrevious: long
  }
}
class OfferFreeAgentContractUseCase <<UseCase>> {
  execute(FreeAgentOfferCommand): FreeAgentOfferDto «@Transactional»
}
class FreeAgentOfferCommand <<record>> {
  careerId: UUID
  playerId: UUID
  years: int
  totalValue: long
  guaranteed: long
  signingBonus: long
  userId: UUID
}
class ProposeTradeUseCase <<UseCase>> {
  execute(TradeCommand): TradeProposalDto «@Transactional»
}
class ClaimWaiverUseCase <<UseCase>> {
  execute(careerId, playerId, userId): WaiverClaimDto
}
interface CapEngine <<Engine>> {
  capHit(contract, season): long
  capImpact(in, out, club): long
  deadMoneyIfCut(contract, season): long
}
interface MarketEngine <<Engine>> {
  decide(player, offers, seed): SigningOutcome
  tradeValue(players, picks, needs): TradeEvaluation
  processWaivers(player, claims): WaiverClaim
}
class TradeEvaluation <<record>> {
  result: ACCEPT|COUNTER|REJECT
  valueIn: int
  valueOut: int
  counterAsk: List<Asset>
  reason: String
}
class WaiverProcessingJob <<Job>> {
  onGameDayEnded(saveId)
}
Club "1" -- "0..53" Player : elenco ativo
Club "*" -- "*" Club : rivais da divisão
Player "1" -- "1" PlayerContract : «embedded»
CareerSave "*" -- "0..1" Club : franquia atual
CareerSave "1" -- "*" Season
CareerSave "1" -- "*" FreeAgentOffer
FreeAgentOffer "*" -- "1" Player
Club "1" -- "*" WaiverClaim
WaiverClaim "*" -- "1" Player
CareerSave "1" -- "*" TradeProposal
TradeProposal "*" -- "*" DraftPick : picks
Club "1" -- "*" DraftPick : picks próprios
Club "1" -- "*" SalaryCapLedger : por temporada
OfferFreeAgentContractUseCase ..> FreeAgentOfferCommand : recebe
OfferFreeAgentContractUseCase ..> CapEngine : capHit
OfferFreeAgentContractUseCase ..> MarketEngine : decide
OfferFreeAgentContractUseCase ..> FreeAgentOffer : cria
ProposeTradeUseCase ..> MarketEngine : tradeValue
MarketEngine ..> TradeEvaluation : produz
ProposeTradeUseCase ..> TradeProposal : cria
ProposeTradeUseCase ..> DraftPick : ownerClub
ClaimWaiverUseCase ..> WaiverClaim : cria
WaiverProcessingJob ..> MarketEngine : processWaivers
CapEngine ..> SalaryCapLedger : lê/atualiza
@enduml
