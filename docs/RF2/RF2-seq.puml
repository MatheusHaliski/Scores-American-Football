@startuml
title RF2 — Autenticação e recuperação de senha · Diagrama de sequência
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
autonumber
actor "Visitante (não autenticado)" as Visitante
actor "Head coach / manager (usuário autenticado)" as Manager
participant "Frontend" as Frontend
boundary "Filtros" as Filtros
boundary "API" as API
control "UseCase" as UseCase
control "AuditService" as AuditService
database "MySQL 8" as MySQL
database "Redis 7" as Redis
participant "Email" as Email
Visitante -> Frontend: e-mail + senha
Frontend -> API: POST /auth/login
API -> Filtros: CorrelationIdFilter · AuthRateLimitFilter(login 30/10 min)
Filtros -> Redis: Lua INCR auth:rate:login:{ip}
alt limite excedido
  Filtros --> Frontend: 429 RATE_LIMITED + Retry-After
else senão
  API -> UseCase: LoginUseCase.execute(cmd, ip, userAgent)
  UseCase -> Redis: PasswordAttemptGuard.tryLogin(emailHash) — ANTES do hash
  alt reserva recusada
    UseCase -> AuditService: failed(LOGIN_LOCKED)
    API --> Frontend: 401 AUTH_FAILED (idêntico)
  else senão
    UseCase -> MySQL: leitura curta: findByEmailHash
    UseCase -> UseCase: PasswordHasher.verify fora da TX (hash fictício se inexistente)
    alt conta inexistente, inativa ou senha incorreta
      UseCase -> AuditService: failed(LOGIN_FAILED) «REQUIRES_NEW»
      API --> Frontend: 401 AUTH_FAILED
    else senão
      UseCase -> Redis: clearLogin(emailHash)
      UseCase -> UseCase: TokenService.access(sub, roles, sid) RS256 15 min · refresh opaco
      UseCase -> MySQL: TX curta: INSERT user_session (refreshTokenHash, familyId, ip, userAgent)
      UseCase -> Redis: SET session:family:{sid} (TTL 7 d)
      UseCase -> AuditService: ok(LOGIN_OK)
      API --> Frontend: 200 {accessToken, expiresIn} + Set-Cookie __Host-refresh HttpOnly Secure SameSite=Strict
      Frontend -> Manager: menu principal (access só em memória)
    end
  end
end
loop access expirado ou aba recarregada
  Frontend -> API: POST /auth/refresh (cookie __Host-refresh, Origin)
  API -> UseCase: RefreshTokenUseCase.execute(cookie, origin, ip)
  UseCase -> MySQL: findByRefreshTokenHash · revokedAt, replacedBy, expiresAt
  alt origem estranha, token reutilizado ou revogado
    UseCase -> MySQL: revoga a família
    UseCase -> AuditService: failed(TOKEN_REUSE_DETECTED)
    API --> Frontend: 401 + cookie apagado → login
  else senão
    UseCase -> MySQL: UPDATE antiga replacedBy · INSERT nova (mesma família)
    API --> Frontend: 200 novo access + novo cookie
  end
end
Visitante -> Frontend: esqueci a senha
Frontend -> API: POST /auth/password/forgot {email}
API -> UseCase: ForgotPasswordUseCase.execute(email)
UseCase -> Email: link de redefinição (token nunca no log)
API --> Frontend: 202 Accepted (sempre)
Frontend -> API: POST /auth/password/reset {token, newPassword}
API -> UseCase: ResetPasswordUseCase.execute(cmd)
alt token inválido ou senha fraca
  API --> Frontend: 422 TOKEN_INVALID | WEAK_PASSWORD
else senão
  UseCase -> MySQL: TX curta: UPDATE passwordHash · revoga todas as famílias
  UseCase -> AuditService: ok(PASSWORD_CHANGED)
  API --> Frontend: 200
end
Manager -> Frontend: sair
Frontend -> API: POST /auth/logout
API -> UseCase: LogoutUseCase.execute(sid)
UseCase -> MySQL: UPDATE user_session SET revokedAt WHERE familyId = sid
UseCase -> Redis: DEL session:family:{sid}
UseCase -> AuditService: ok(LOGOUT)
API --> Frontend: 204 + cookie expirado
Frontend -> Frontend: BroadcastChannel logout → outras abas limpam a memória
@enduml
