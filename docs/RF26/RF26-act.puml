@startuml
title RF26 — Estádio 3D e loja de estádio modular · Diagrama de atividades
skinparam ActivityBackgroundColor #FFF7EE
skinparam ActivityBorderColor #DC5B26
skinparam ActivityDiamondBackgroundColor #FBE9D8
skinparam swimlaneWidth same
|Manager|
start
:Abre a aba Estádio 3D;
|Frontend|
:GET /careers/{id}/stadium + GET /store/catalog?category=STADIUM_3D;
|Backend|
if (dono do save?) then (sim)
else (não)
  :403 + auditoria ACCESS_DENIED;
  stop
endif
|Frontend|
:Viewer R3F: campo 120 × 53,3 jardas, traves em Y, end zones com o nome do time, arquibancadas e cobertura, setores clicáveis;
|Backend|
if (head coach empregado?) then (sim)
else (não)
|Frontend|
  :Somente visualização;
  stop
endif
|Manager|
if (compra estádio modular?) then (sim)
|Frontend|
  :POST /store/purchases {STADIUM_3D} + Idempotency-Key;
|Backend|
  if (item da loja: possuído, saldo e compatível?) then (sim)
  else (não)
    :409 / 422;
    stop
  endif
  :Debita pontos · Purchase · AuditLog STORE_PURCHASE;
|Frontend|
  :POST /me/inventory/{iid}/apply → stadium.model3dUrl;
else (não)
|Manager|
  :Clica em setor (ampliar, reformar, preço, remover), Adicionar setor ou Obra de cobertura/superfície;
|Backend|
  if (sem partida ao vivo?) then (sim)
  else (não)
    :409 STADIUM_LOCKED_DURING_MATCH;
    stop
  endif
  if (é remoção?) then (sim)
    if (setor removível?) then (sim)
      :Remove setor · recalcula capacidade e manutenção;
    else (não)
      :422 MIN_SECTORS;
      stop
    endif
  else (não)
    if (obra grande na offseason?) then (sim)
    else (não)
      :409 OFFSEASON_ONLY;
      stop
    endif
    if (preço plausível?) then (sim)
    else (não)
      :422 TICKET_PRICE_OUT_OF_RANGE;
      stop
    endif
    if (capacidade dentro da faixa?) then (sim)
    else (não)
      :422 CAPACITY_OUT_OF_RANGE;
      stop
    endif
    if (caixa cobre a obra?) then (sim)
    else (não)
      :422 INSUFFICIENT_CASH;
      stop
    endif
|Diretoria|
    if (aprova obra grande?) then (sim)
    else (não)
|Backend|
      :422 BOARD_VETO + inbox;
      stop
    endif
    :TX: ledger STADIUM · setor ou obra em andamento · atmosfera e clima de jogo recalculados;
  endif
endif
|Frontend|
:Atualiza a cena 3D (setor novo, cobertura, gramado);
end
@enduml
