@startuml
title RF26 — Estádio 3D e loja de estádio modular · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
actor "Diretoria da franquia (IA)" as c2
package "Frontend (Next.js)" as pkg_fe {
  component "StadiumPage" as c3
  frame "componentes de StadiumPage" as pkg_fe_sub {
    component "Stadium3DViewer" as c4
    component "FieldMarkings" as c5
    component "SectorInspector" as c6
    component "SectorEditorDialog" as c7
    component "RenovationDialog" as c8
    component "EndZoneArtEditor" as c9
    component "ModularStadiumShop" as c10
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "StadiumController" as c11
  component "StoreController" as c12
  component "InventoryController" as c13
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "GetStadiumUseCase" as c14
  component "UpdateStadiumUseCase" as c15
  component "AddStadiumSectorUseCase" as c16
  component "UpgradeStadiumSectorUseCase" as c17
  component "RemoveStadiumSectorUseCase" as c18
  component "StartStadiumRenovationUseCase" as c19
  component "PurchaseService" as c20
  component "ApplyInventoryItemUseCase" as c21
  component "CareerAccess" as c22
  component "BoardInvestmentPolicy" as c23
}
package "scores-af-domain/engine" as pkg_eng {
  component "FinanceEngine" as c24
}
package "portas (port.out)" as pkg_ports {
  interface "CareerSaveRepository" as c25
  interface "StadiumRepository" as c26
  interface "StadiumSectorRepository" as c27
  interface "ClubRepository" as c28
  interface "FinanceLedgerRepository" as c29
  interface "StoreItemRepository" as c30
  interface "PurchaseRepository" as c31
  interface "LiveMatchStatePort" as c32
  interface "MediaStoragePort" as c33
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c34
  component "cache-redis" as c35
  component "storage-s3" as c36
}
database "MySQL 8" as s1
database "Redis 7" as s2
database "S3/MinIO" as s3
c1 --> c3 : usa
c3 --> c11 : GET /careers/{id}/stadium (alvo)\nPUT /careers/{id}/stadium (alvo)\nPOST /careers/{id}/stadium/sectors (alvo)\n…
c3 --> c12
c3 --> c13
c11 --> c14
c12 --> c14
c13 --> c14
c14 ..> pkg_app : orquestra
c14 --> c24 : usa
pkg_app --> pkg_ports : depende (DIP)
c34 .up.|> c25
c34 .up.|> c26
c34 .up.|> c27
c34 .up.|> c28
c34 .up.|> c29
c34 .up.|> c30
c34 .up.|> c31
c35 .up.|> c32
c36 .up.|> c33
c34 --> s1
c35 --> s2
c36 --> s3
@enduml
