@startuml
title RF27 — Painel da semana e partida ao vivo · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "career" {
  class CareerSave {
    id: UUID
    name: String
    seed: long
    employmentStatus: EmploymentStatus
    currentWeek: int
    difficulty: Difficulty
    seasonMode: SeasonMode
    scoresPoints: int
    status: SaveStatus
    slot: int
    lastPlayedAt: Instant
  }
}
package "season" {
  class Week {
    number: int
    kind: WeekKind (PRESEASON|REGULAR|WILD_CARD|DIVISIONAL|CONFERENCE|FINAL)
    startsOn: LocalDate
    status: WeekStatus
    byeClubs: List<Club>
  }
  class Fixture {
    week: int
    date: LocalDate
    slot: KickoffSlot (THU_NIGHT|SUN_EARLY|SUN_LATE|SUN_NIGHT|MON_NIGHT)
    status: FixtureStatus
    homeScore: int
    awayScore: int
    quarterScores: JSON
    overtime: boolean
    isDivisional: boolean
    isConference: boolean
    neutralSite: boolean
    weather: Weather
    attendance: int
    revenue: long
    importance: FixtureImportance
    seed: long
    isUserFixture: boolean
  }
}
package "catalog" {
  class Club {
    id: UUID
    name: String
    shortName: String
    city: String
    conference: Conference
    division: Division
    logoKey: String
    primaryColor: String
    secondaryColor: String
    accentColor: String
    prestige: int
    reputationBoard: int
    reputationFans: int
    cash: long
    capSpace: long
    isUserControlled: boolean
    expectedWins: int
    scoutingLevel: int
    scoutingBudget: long
  }
}
package "match" {
  class MatchSession {
    status: LiveStatus
    quarter: int
    clockSeconds: int
    playClockSeconds: int
    possession: Club
    down: int (1–4)
    distance: int
    ballOnAbsYd: int (0–100)
    homeScore: int
    awayScore: int
    timeoutsHome: int
    timeoutsAway: int
    seed: long
    rngCursor: long
    snapshotJson: TEXT
    decisionsLog: JSON
    version: long
  }
  class Drive {
    seq: int
    club: Club
    quarter: int
    startAbsYd: int
    plays: int
    yards: int
    timeOfPossessionSec: int
    result: DriveResult (TD|FG|PUNT|TURNOVER|DOWNS|SAFETY|END_HALF)
  }
  class PlayEvent {
    «Cassandra» fixtureId: UUID
    seq: int
    drive: int
    quarter: int
    clock: String
    down: int
    distance: int
    ballOnAbsYd: int
    playType: PlayType
    formation: Formation
    defense: Coverage
    yards: int
    result: PlayResult
    penalty: Penalty?
    playerIds: List<UUID>
    text: String
    homeScore: int
    awayScore: int
  }
  class Penalty {
    code: PenaltyCode (FALSE_START|OFFSIDE|ENCROACHMENT|HOLDING_O|HOLDING_D|DPI|OPI|ROUGHING_PASSER|UNNECESSARY_ROUGHNESS|DELAY_OF_GAME|ILLEGAL_FORMATION|FACEMASK|INTENTIONAL_GROUNDING)
    yards: int
    automaticFirstDown: boolean
    lossOfDown: boolean
    accepted: boolean
    against: Club
  }
  class PlayCallDecision {
    session: MatchSession
    situation: Situation (FOURTH_DOWN|TWO_MINUTE|OVERTIME|ALL_PLAYS)
    down: int
    distance: int
    ballOnAbsYd: int
    options: List<PlayDefinition>
    chosen: PlayDefinition?
    deadlineAt: Instant
    auto: boolean
    status: DecisionStatus
  }
  class TeamMatchStats {
    firstDowns: int
    thirdDown: String
    fourthDown: String
    redZone: String
    totalYards: int
    passYards: int
    rushYards: int
    timeOfPossession: String
    turnovers: int
    penalties: int
    penaltyYards: int
    sacks: int
  }
}
class GetWeekBoardUseCase <<UseCase>> {
  execute(careerId, week, userId): WeekBoardDto
}
class AdvanceMatchUseCase <<UseCase>> {
  execute(matchId, mode, userId): MatchStateDto
}
class WeekBoardDto <<record>> {
  week: int
  slots: Map<KickoffSlot, List<ScoreCardDto>>
  byes: List<ClubCompactDto>
  myFixtureId: UUID?
  spectator: boolean
}
class MatchStateDto <<record>> {
  status: LiveStatus
  quarter: int
  clock: String
  playClock: int
  possession: UUID
  down: int
  distance: int
  ballOnAbsYd: int
  downAndDistanceLabel: String (3rd and 7 at OPP 34)
  currentDrive: DriveDto
  timeouts: int[2]
  pendingDecision: UUID?
  lastSeq: long
}
enum AdvanceMode {
  PLAY
  DRIVE
  QUARTER
  FULL
}
interface LiveMatchStatePort <<Port>> {
  get(fixtureId): MatchSnapshot?
  put(fixtureId, snapshot, ttl)
  getMany(ids): Map
}
Club "*" -- "*" Club : rivais da divisão
CareerSave "*" -- "0..1" Club : franquia atual
Week "1" -- "*" Fixture
Fixture "*" -- "1" Club : mandante
Fixture "1" -- "0..1" MatchSession : estado vivo
MatchSession "1" -- "*" PlayCallDecision : momentos decisivos
Fixture "1" -- "*" Drive : drives
Fixture "1" -- "*" PlayEvent : play-by-play
PlayEvent "1" -- "0..1" Penalty
Fixture "1" -- "2" TeamMatchStats
GetWeekBoardUseCase ..> WeekBoardDto : produz
GetWeekBoardUseCase ..> LiveMatchStatePort : placares parciais
AdvanceMatchUseCase ..> AdvanceMode : recebe
AdvanceMatchUseCase ..> MatchStateDto : produz
AdvanceMatchUseCase ..> PlayCallDecision : bloqueia se OPEN
@enduml
