@startuml
title RF30 — Classificação, seeds e notícias com IA · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "career" {
  class CareerSave {
    id: UUID
    name: String
    seed: long
    employmentStatus: EmploymentStatus
    currentWeek: int
    difficulty: Difficulty
    seasonMode: SeasonMode
    scoresPoints: int
    status: SaveStatus
    slot: int
    lastPlayedAt: Instant
  }
}
package "season" {
  class Season {
    number: int
    year: int
    phase: SeasonPhase (PRESEASON|REGULAR|PLAYOFFS|DRAFT|FREE_AGENCY|OFFSEASON)
    currentWeek: int
    tradeDeadlineWeek: int
    championClub: Club?
    mvpPlayer: Player?
  }
  class Week {
    number: int
    kind: WeekKind (PRESEASON|REGULAR|WILD_CARD|DIVISIONAL|CONFERENCE|FINAL)
    startsOn: LocalDate
    status: WeekStatus
    byeClubs: List<Club>
  }
  class Fixture {
    week: int
    date: LocalDate
    slot: KickoffSlot (THU_NIGHT|SUN_EARLY|SUN_LATE|SUN_NIGHT|MON_NIGHT)
    status: FixtureStatus
    homeScore: int
    awayScore: int
    quarterScores: JSON
    overtime: boolean
    isDivisional: boolean
    isConference: boolean
    neutralSite: boolean
    weather: Weather
    attendance: int
    revenue: long
    importance: FixtureImportance
    seed: long
    isUserFixture: boolean
  }
  class Standing {
    wins: int
    losses: int
    ties: int
    winPct: double
    divisionRecord: String
    conferenceRecord: String
    pointsFor: int
    pointsAgainst: int
    streak: int
    last5: JSON
    divisionRank: int
    conferenceSeed: Integer
    tiebreakerNote: String
  }
  class PlayoffSeed {
    conference: Conference
    seed: int (1–7)
    club: Club
    divisionWinner: boolean
    hasBye: boolean (seed 1)
  }
  class PlayoffMatchup {
    round: PlayoffRound (WILD_CARD|DIVISIONAL|CONFERENCE|FINAL)
    higherSeed: PlayoffSeed
    lowerSeed: PlayoffSeed
    fixture: Fixture
    winner: Club?
    neutralSite: boolean
    status: MatchupStatus (SCHEDULED|LIVE|DECIDED)
  }
}
package "catalog" {
  class Conference {
    name: String
    shortName: String
    logoKey: String
  }
  class Division {
    name: String
    conference: Conference
    teamCount: int = 4
  }
  class Club {
    id: UUID
    name: String
    shortName: String
    city: String
    conference: Conference
    division: Division
    logoKey: String
    primaryColor: String
    secondaryColor: String
    accentColor: String
    prestige: int
    reputationBoard: int
    reputationFans: int
    cash: long
    capSpace: long
    isUserControlled: boolean
    expectedWins: int
    scoutingLevel: int
    scoutingBudget: long
  }
}
package "inbox" {
  class NewsItem {
    week: int
    headline: String
    body: TEXT
    journalist: String
    tone: Tone
  }
}
class GetStandingsUseCase <<UseCase>> {
  execute(careerId, view, userId): StandingsDto
}
class StandingsDto <<record>> {
  phase: SeasonPhase
  view: DIVISION|CONFERENCE|LEAGUE
  groups: List<StandingGroupDto>
  seeds: List<SeedDto>
  bracket: List<MatchupDto>?
  provisional: boolean
}
class SeedingPolicy <<Policy>> {
  seeds(conference, standings): List<PlayoffSeed> «4 campeões de divisão + 3 wild cards»
}
class TiebreakPolicy <<Policy>> {
  compare(a, b, context): int «confronto, divisão, comuns, conferência, SOV, SOS, pontos»
  note(a, b): String
}
class GenerateWeekNewsJob <<Job>> {
  onWeekCompleted(WeekCompleted)
}
interface AiNarrativePort <<Port>> {
  generateNews(NewsPrompt): List<NewsDraft>
}
Conference "1" -- "*" Division : divisões
Division "1" -- "*" Club : franquias
Club "*" -- "*" Club : rivais da divisão
CareerSave "*" -- "0..1" Club : franquia atual
CareerSave "1" -- "*" Season
Season "1" -- "18..22" Week : semanas
Week "1" -- "*" Fixture
Season "1" -- "*" Standing
Season "1" -- "14" PlayoffSeed : 7 por conferência
Season "1" -- "13" PlayoffMatchup : chave
PlayoffMatchup "1" -- "1" Fixture
Season "1" -- "*" NewsItem
Fixture "*" -- "1" Club : mandante
GetStandingsUseCase ..> StandingsDto : produz
GetStandingsUseCase ..> TiebreakPolicy : usa
SeedingPolicy ..> PlayoffSeed : produz
SeedingPolicy ..> TiebreakPolicy : usa
GenerateWeekNewsJob ..> AiNarrativePort : usa
GenerateWeekNewsJob ..> NewsItem : cria
@enduml
