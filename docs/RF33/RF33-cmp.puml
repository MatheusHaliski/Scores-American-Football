@startuml
title RF33 — Scores Points por metas em qualquer modo · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
actor "Agendador/Job assíncrono" as c2
package "Frontend (Next.js)" as pkg_fe {
  component "GoalsTab" as c3
  frame "componentes de GoalsTab" as pkg_fe_sub {
    component "WalletBadge" as c4
    component "PointsLedgerList" as c5
    component "GoalCompletedToast" as c6
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "GoalController" as c7
  component "WalletController" as c8
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "GameRewardService" as c9
  component "PointsService" as c10
  component "WalletService" as c11
  component "GetGoalsUseCase" as c12
  component "CareerAccess" as c13
}
package "scores-af-domain/engine" as pkg_eng {
  component "SeasonEngine" as c14
}
package "portas (port.out)" as pkg_ports {
  interface "CareerSaveRepository" as c15
  interface "GoalRepository" as c16
  interface "ScoresPointsWalletRepository" as c17
  interface "PointsTransactionRepository" as c18
  interface "CounterPort" as c19
  interface "TimelinePort" as c20
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c21
  component "cache-redis" as c22
  component "persistence-cassandra" as c23
}
database "MySQL 8" as s1
database "Redis 7" as s2
database "Cassandra 4.1" as s3
c1 --> c3 : usa
c2 --> c9 : dispara
c3 --> c7 : GET /careers/{id}/goals (alvo)\nGET /careers/{id}/wallet (alvo)\nGET /me/wallet (alvo)
c3 --> c8
c7 --> c9
c8 --> c9
c9 ..> pkg_app : orquestra
c9 --> c14 : usa
pkg_app --> pkg_ports : depende (DIP)
c21 .up.|> c15
c21 .up.|> c16
c21 .up.|> c17
c21 .up.|> c18
c22 .up.|> c19
c23 .up.|> c20
c21 --> s1
c22 --> s2
c23 --> s3
@enduml
