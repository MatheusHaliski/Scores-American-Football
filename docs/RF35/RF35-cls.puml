@startuml
title RF35 — Fim de temporada: playoffs, renovações, free agency e draft · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "season" {
  class Season {
    number: int
    year: int
    phase: SeasonPhase (PRESEASON|REGULAR|PLAYOFFS|DRAFT|FREE_AGENCY|OFFSEASON)
    currentWeek: int
    tradeDeadlineWeek: int
    championClub: Club?
    mvpPlayer: Player?
  }
  class Standing {
    wins: int
    losses: int
    ties: int
    winPct: double
    divisionRecord: String
    conferenceRecord: String
    pointsFor: int
    pointsAgainst: int
    streak: int
    last5: JSON
    divisionRank: int
    conferenceSeed: Integer
    tiebreakerNote: String
  }
  class PlayoffSeed {
    conference: Conference
    seed: int (1–7)
    club: Club
    divisionWinner: boolean
    hasBye: boolean (seed 1)
  }
  class PlayoffMatchup {
    round: PlayoffRound (PRELIMINARY|WILD_CARD|DIVISIONAL|CONFERENCE|FINAL)
    higherSeed: PlayoffSeed
    lowerSeed: PlayoffSeed
    fixture: Fixture
    winner: Club?
    neutralSite: boolean
    status: MatchupStatus (SCHEDULED|LIVE|DECIDED)
  }
  class SeasonAward {
    type: AwardType (MVP|OPOY|DPOY|OROY|DROY|COACH)
    value: double
  }
  class ChampionHistory {
    seasonYear: int
    managerName: String
    finalScore: String
  }
}
package "catalog" {
  class Club {
    id: UUID
    name: String
    shortName: String
    city: String
    conference: Conference
    division: Division
    logoKey: String
    primaryColor: String
    secondaryColor: String
    accentColor: String
    prestige: int
    reputationBoard: int
    reputationFans: int
    cash: long
    capSpace: long
    isUserControlled: boolean
    expectedWins: int
    scoutingLevel: int
    scoutingBudget: long
  }
  class Player {
    id: UUID
    name: String
    nationality: String
    college: String
    birthDate: LocalDate
    age: int
    heightCm: int
    weightKg: int
    position: Position (QB|RB|FB|WR|TE|LT|LG|C|RG|RT|DE|DT|OLB|MLB|CB|FS|SS|K|P|LS)
    unit: Unit (OFFENSE|DEFENSE|SPECIAL)
    attributes: PlayerAttributes
    overall: int «por posição, OVR v1»
    potential: int
    experienceYears: int
    rosterStatus: RosterStatus (ACTIVE|INACTIVE|PRACTICE_SQUAD|IR|PUP|FREE_AGENT|WAIVED)
    condition: int
    morale: int
    moraleFactors: JSON
    injury: Injury?
    suspensionWeeks: int
    contract: PlayerContract
    jerseyNumber: int
    isLegendary: boolean
    model3dUrl: String
  }
}
package "career" {
  class ManagerContract {
    salaryPerSeason: long
    startSeason: int
    endSeason: int
    objectives: JSON (vitórias, playoffs, título)
    releaseClause: long
    status: ContractStatus
  }
  class JobOffer {
    salary: long
    seasons: int
    objectives: JSON
    status: OfferStatus
    expiresWeek: int
    reason: String
  }
}
package "market" {
  class PlayerContract {
    «embedded» years: int
    baseSalaryByYear: JSON
    signingBonus: long «rateado»
    guaranteed: long
    capHitByYear: JSON
    deadMoneyIfCut: long
    franchiseTag: boolean
    type: ContractType (ROOKIE|VETERAN|MINIMUM|TAG|PRACTICE)
    endSeason: int
  }
  class DraftClass {
    season: int
    size: int
    status: DraftStatus (SCOUTING|COMBINE|LIVE|DONE)
  }
  class DraftPick {
    season: int (até 3 à frente)
    round: int (1–7)
    overall: Integer
    originalClub: Club
    ownerClub: Club
    compensatory: boolean
  }
}
package "finance" {
  class SalaryCapLedger {
    season: int
    cap: long
    committed: long
    deadMoney: long
    space: long
    rolloverFromPrevious: long
  }
}
class AdvanceOffseasonPhaseUseCase <<UseCase>> {
  execute(careerId, userId): SeasonDto «idempotente por fase»
}
class SeasonSummaryDto <<record>> {
  champion: ChampionDto
  bracket: BracketDto
  standings: por divisão e conferência
  awards: List<AwardDto>
  recap: String
  phase: SeasonPhase
  pendingDecisions: List<String>
}
class AwardsCalculator <<Engine>> {
  mvp(season)
  opoy(season)
  dpoy(season)
  oroy(season)
  droy(season)
  coach(season)
}
class DraftOrderPolicy <<Policy>> {
  order(standings, bracket): List<Club> «inversa»
}
Club "1" -- "0..53" Player : elenco ativo
Club "*" -- "*" Club : rivais da divisão
Player "1" -- "1" PlayerContract : «embedded»
Season "1" -- "*" Standing
Season "1" -- "14" PlayoffSeed : 7 por conferência
Season "1" -- "13" PlayoffMatchup : chave
Season "1" -- "*" SeasonAward
Club "1" -- "*" DraftPick : picks próprios
Season "1" -- "1" DraftClass
Club "1" -- "*" SalaryCapLedger : por temporada
AdvanceOffseasonPhaseUseCase ..> Season : phase
AdvanceOffseasonPhaseUseCase ..> SalaryCapLedger : valida n+1
AwardsCalculator ..> SeasonAward : cria
DraftOrderPolicy ..> DraftPick : overall
DraftOrderPolicy ..> PlayoffMatchup : lê
@enduml
