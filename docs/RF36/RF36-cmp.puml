@startuml
title RF36 — Simular a temporada pelo calendário · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
actor "Agendador/Job assíncrono" as c2
actor "Diretoria da franquia (IA)" as c3
package "Frontend (Next.js)" as pkg_fe {
  component "CalendarPage" as c4
  frame "componentes de CalendarPage" as pkg_fe_sub {
    component "SimulateDialog" as c5
    component "SimulationProgress" as c6
    component "SimulationSummary" as c7
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "SimulationController" as c8
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "SimulationRunService" as c9
  component "StartSimulationUseCase" as c10
  component "ResumeSimulationUseCase" as c11
  component "StopSimulationUseCase" as c12
}
package "scores-af-domain/engine" as pkg_eng {
  component "WeekProcessor" as c13
  component "MatchSimulator" as c14
  component "PlayCaller (IA)" as c15
  component "MandatoryStopDetector" as c16
}
package "portas (port.out)" as pkg_ports {
  interface "SimulationRunRepository" as c17
  interface "FixtureRepository" as c18
  interface "TimelinePort" as c19
  interface "CachePort" as c20
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c21
  component "persistence-cassandra" as c22
  component "cache-redis" as c23
}
database "MySQL 8" as s1
database "Redis 7" as s2
database "Cassandra 4.1" as s3
c1 --> c4 : usa
c2 --> c9 : dispara
c4 --> c8 : POST /careers/{id}/simulate (alvo)\nGET /careers/{id}/simulate/active (alvo)\nGET /careers/{id}/simulate/{runId} (alvo)\n…
c8 --> c9
c9 ..> pkg_app : orquestra
c9 --> c13 : usa
c9 --> c14 : usa
c9 --> c15 : usa
c9 --> c16 : usa
pkg_app --> pkg_ports : depende (DIP)
c21 .up.|> c17
c21 .up.|> c18
c22 .up.|> c19
c23 .up.|> c20
c21 --> s1
c22 --> s3
c23 --> s2
@enduml
