@startuml
title RF51 — Draft, scouting universitário e combine · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
actor "Franquia adversária (IA)" as c2
actor "Agendador/Job assíncrono" as c3
package "Frontend (Next.js)" as pkg_fe {
  component "DraftRoomPage" as c4
  frame "componentes de DraftRoomPage" as pkg_fe_sub {
    component "ProspectTable" as c5
    component "ProspectCard" as c6
    component "CombineChart" as c7
    component "BigBoardEditor" as c8
    component "DraftClockBanner" as c9
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "DraftController" as c10
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "DraftUseCases" as c11
  component "BuyScoutingReportUseCase" as c12
  component "MakeDraftPickUseCase" as c13
  component "AdvanceDraftUseCase" as c14
  component "CareerAccess" as c15
}
package "scores-af-domain/engine" as pkg_eng {
  component "DraftEngine" as c16
  component "DraftOrderPolicy" as c17
  component "ScoutingFogPolicy" as c18
  component "RookieScalePolicy" as c19
}
package "portas (port.out)" as pkg_ports {
  interface "DraftClassRepository" as c20
  interface "DraftPickRepository" as c21
  interface "PlayerRepository" as c22
  interface "SalaryCapLedgerRepository" as c23
  interface "LiveChannelPort" as c24
  interface "TimelinePort" as c25
  interface "SearchPort" as c26
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c27
  component "cache-redis" as c28
  component "persistence-cassandra" as c29
  component "search-opensearch" as c30
}
database "MySQL 8" as s1
database "Redis 7" as s2
database "Cassandra 4.1" as s3
database "OpenSearch 2" as s4
c1 --> c4 : usa
c3 --> c11 : dispara
c4 --> c10 : GET /careers/{id}/draft/class (alvo)\nGET /careers/{id}/draft/prospects/{pid} (alvo)\nPOST /careers/{id}/draft/prospects/{pid}/scouting (alvo)\n…
c10 --> c11
c11 ..> pkg_app : orquestra
c11 --> c16 : usa
c11 --> c17 : usa
c11 --> c18 : usa
c11 --> c19 : usa
pkg_app --> pkg_ports : depende (DIP)
c27 .up.|> c20
c27 .up.|> c21
c27 .up.|> c22
c27 .up.|> c23
c28 .up.|> c24
c29 .up.|> c25
c30 .up.|> c26
c27 --> s1
c28 --> s2
c29 --> s3
c30 --> s4
@enduml
