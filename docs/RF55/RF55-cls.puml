@startuml
title RF55 — Snaps-alvo, rodízio da linha e química · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "catalog" {
  class Club {
    id: UUID
    name: String
    shortName: String
    city: String
    conference: Conference
    division: Division
    logoKey: String
    primaryColor: String
    secondaryColor: String
    accentColor: String
    prestige: int
    reputationBoard: int
    reputationFans: int
    cash: long
    capSpace: long
    isUserControlled: boolean
    expectedWins: int
    scoutingLevel: int
    scoutingBudget: long
  }
  class Player {
    id: UUID
    name: String
    nationality: String
    college: String
    birthDate: LocalDate
    age: int
    heightCm: int
    weightKg: int
    position: Position (QB|RB|FB|WR|TE|LT|LG|C|RG|RT|DE|DT|OLB|MLB|CB|FS|SS|K|P|LS)
    unit: Unit (OFFENSE|DEFENSE|SPECIAL)
    attributes: PlayerAttributes
    overall: int «por posição, OVR v1»
    potential: int
    experienceYears: int
    rosterStatus: RosterStatus (ACTIVE|INACTIVE|PRACTICE_SQUAD|IR|PUP|FREE_AGENT|WAIVED)
    condition: int
    morale: int
    moraleFactors: JSON
    injury: Injury?
    suspensionWeeks: int
    contract: PlayerContract
    jerseyNumber: int
    isLegendary: boolean
    model3dUrl: String
  }
}
package "match" {
  class DepthChart {
    club: Club
    version: long
    updatedAt: Instant
    validated: boolean
  }
  class DepthChartSlot {
    unit: Unit
    position: Position | Role (KR|PR|3RD_DOWN_BACK|SNAPPER|HOLDER)
    depth: int (1, 2, 3…)
    player: Player
    outOfPosition: boolean
  }
  class PlayerMatchStats {
    snaps: int
    passing: cmp/att, yds, td, int, rating, sacked
    rushing: att, yds, avg, td, fum
    receiving: tgt, rec, yds, yac, td, drops
    defense: tkl solo/ast, tfl, sacks, qbHits, int, pd, ff, fr
    kicking: fg por distância, pat, punts, avg, in20
    returns: kr/pr, yds, td
    rating: double
  }
}
class SnapPlan <<record>> {
  club: UUID
  targets: Map<UUID, Integer> «% de snaps»
  dlRotation: List<UUID>
  version: long
}
class UnitChemistry <<record>> {
  kind: OL | QB_WR | QB_TE
  playerIds: List<UUID>
  snapsTogether: int
  level: ChemistryLevel
  bonus: double
}
class UpdateSnapPlanUseCase <<UseCase>> {
  execute(saveId, SnapPlan, expectedVersion): SnapPlanResult
}
class ChemistryPolicy <<Policy>> {
  update(chemistry, snapsTogether, starterChanged): UnitChemistry
}
class SubstitutionPolicy <<Policy>> {
  next(state, SnapPlan, fatigue): List<UUID>
}
Club "1" -- "0..53" Player : elenco ativo
Club "*" -- "*" Club : rivais da divisão
Club "1" -- "1" DepthChart
DepthChart "1" -- "*" DepthChartSlot : slots
DepthChartSlot "*" -- "1" Player
UpdateSnapPlanUseCase ..> SnapPlan : grava
SubstitutionPolicy ..> SnapPlan : lê
ChemistryPolicy ..> UnitChemistry : atualiza
UnitChemistry ..> Player : agrupa
@enduml
