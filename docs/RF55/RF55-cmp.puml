@startuml
title RF55 — Snaps-alvo, rodízio da linha e química · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
actor "Jogador (IA)" as c2
package "Frontend (Next.js)" as pkg_fe {
  component "SnapPlanPage" as c3
  frame "componentes de SnapPlanPage" as pkg_fe_sub {
    component "SnapTargetSlider" as c4
    component "DlRotationBoard" as c5
    component "ChemistryMeter" as c6
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "SnapPlanController" as c7
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "SnapPlanUseCases" as c8
  component "GetUnitChemistryUseCase" as c9
  component "CareerAccess" as c10
}
package "scores-af-domain/engine" as pkg_eng {
  component "ClubAnalyst" as c11
  component "SubstitutionPolicy" as c12
  component "ChemistryPolicy" as c13
  component "FatiguePolicy" as c14
  component "MoraleEngine" as c15
}
package "portas (port.out)" as pkg_ports {
  interface "SnapPlanRepository" as c16
  interface "DepthChartRepository" as c17
  interface "MatchStatsRepository" as c18
  interface "MatchStatePort" as c19
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c20
  component "cache-redis" as c21
}
database "MySQL 8" as s1
database "Redis 7" as s2
c1 --> c3 : usa
c3 --> c7 : GET /careers/{id}/snap-plan (alvo)\nPUT /careers/{id}/snap-plan (alvo)\nGET /careers/{id}/chemistry (alvo)
c7 --> c8
c8 ..> pkg_app : orquestra
c8 --> c11 : usa
c8 --> c12 : usa
c8 --> c13 : usa
c8 --> c14 : usa
c8 --> c15 : usa
pkg_app --> pkg_ports : depende (DIP)
c20 .up.|> c16
c20 .up.|> c17
c20 .up.|> c18
c21 .up.|> c19
c20 --> s1
c21 --> s2
@enduml
