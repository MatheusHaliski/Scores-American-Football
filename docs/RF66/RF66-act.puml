  if (usuário eliminado?) then (sim)
    :Simula o restante sem parar;
  endif
endwhile (não)
if (final neutra?) then (sim)
  :Final em estádio neutro;
else (não)
  :Final na casa do melhor seed;
endif
:Campeão em Season.championClub e ChampionHistory;
