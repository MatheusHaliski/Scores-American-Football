@startuml
title RF66 — Playoffs com chave · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "season" {
  class Season {
    number: int
    year: int
    phase: SeasonPhase (PRESEASON|REGULAR|PLAYOFFS|DRAFT|FREE_AGENCY|OFFSEASON)
    currentWeek: int
    tradeDeadlineWeek: int
    championClub: Club?
    mvpPlayer: Player?
  }
  class Standing {
    wins: int
    losses: int
    ties: int
    winPct: double
    divisionRecord: String
    conferenceRecord: String
    pointsFor: int
    pointsAgainst: int
    streak: int
    last5: JSON
    divisionRank: int
    conferenceSeed: Integer
    tiebreakerNote: String
  }
  class PlayoffSeed {
    conference: Conference
    seed: int (1–7)
    club: Club
    divisionWinner: boolean
    hasBye: boolean (seed 1)
  }
  class PlayoffMatchup {
    round: PlayoffRound (PRELIMINARY|WILD_CARD|DIVISIONAL|CONFERENCE|FINAL)
    higherSeed: PlayoffSeed
    lowerSeed: PlayoffSeed
    fixture: Fixture
    winner: Club?
    neutralSite: boolean
    status: MatchupStatus (SCHEDULED|LIVE|DECIDED)
  }
  class Fixture {
    week: int
    date: LocalDate
    slot: KickoffSlot (THU_NIGHT|SUN_EARLY|SUN_LATE|SUN_NIGHT|MON_NIGHT)
    status: FixtureStatus
    homeScore: int
    awayScore: int
    quarterScores: JSON
    overtime: boolean
    isDivisional: boolean
    isConference: boolean
    neutralSite: boolean
    weather: Weather
    attendance: int
    revenue: long
    importance: FixtureImportance
    seed: long
    isUserFixture: boolean
  }
  class ChampionHistory {
    seasonYear: int
    managerName: String
    finalScore: String
  }
}
package "catalog" {
  class League {
    id: UUID
    name: String
    country: String
    ruleset: Ruleset (PRO|COLLEGE)
    rules: LeagueRules
    teamCount: int (8–32)
    conferenceCount: int
    divisionsPerConference: int
    regularSeasonWeeks: int = 18
    gamesPerTeam: int = 17
    playoffSeedsPerConference: int = 7
    neutralSiteFinal: boolean
    salaryCap: long
    salaryFloor: long
    prestige: int
    tvRightsPerSeason: long
  }
  class Conference {
    name: String
    shortName: String
    logoKey: String
  }
  class Club {
    id: UUID
    name: String
    shortName: String
    city: String
    conference: Conference
    division: Division
    logoKey: String
    primaryColor: String
    secondaryColor: String
    accentColor: String
    prestige: int
    reputationBoard: int
    reputationFans: int
    cash: long
    capSpace: long
    isUserControlled: boolean
    expectedWins: int
    scoutingLevel: int
    scoutingBudget: long
  }
}
class PlayoffSeedingPolicy <<Policy>> {
  seed(conference, standings, seedsPerConference): List<PlayoffSeed>
}
class TiebreakerPolicy <<Policy>> {
  order(clubs, season, rng): List<Club>
}
class BracketPolicy <<Policy>> {
  wildCard(seeds): List<PlayoffMatchup>
  reseed(winners): List<PlayoffMatchup>
  final(a, b, neutralSite): PlayoffMatchup
}
League "1" -- "1..2" Conference : conferências
Club "*" -- "*" Club : rivais da divisão
Season "1" -- "*" Standing
Season "1" -- "14" PlayoffSeed : 7 por conferência
Season "1" -- "13" PlayoffMatchup : chave
PlayoffMatchup "1" -- "1" Fixture
League "1" -- "*" ChampionHistory
Fixture "*" -- "1" Club : mandante
PlayoffSeedingPolicy ..> TiebreakerPolicy : usa
PlayoffSeedingPolicy ..> PlayoffSeed : cria
BracketPolicy ..> PlayoffMatchup : cria
@enduml
