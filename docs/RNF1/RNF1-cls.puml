@startuml
title RNF1 — Transações ACID em dados de usuários, carreiras e database do jogo · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "catalog" {
  class World {
    id: UUID
    ownerUser: UserAccount?
    name: String
    kind: WorldKind
    sourceWorld: World?
  }
  class League {
    id: UUID
    name: String
    country: String
    ruleset: Ruleset (PRO|COLLEGE)
    rules: LeagueRules
    teamCount: int (8–32)
    conferenceCount: int
    divisionsPerConference: int
    regularSeasonWeeks: int = 18
    gamesPerTeam: int = 17
    playoffSeedsPerConference: int = 7
    neutralSiteFinal: boolean
    salaryCap: long
    salaryFloor: long
    prestige: int
    tvRightsPerSeason: long
  }
  class LeagueRules {
    «embedded» version: int
    quarterMinutes: int = 15
    playClockSeconds: int = 40
    playClockAfterStoppageSeconds: int = 25
    twoMinuteWarning: boolean
    timeoutsPerHalf: int = 3
    overtimeMinutes: int = 10
    overtimeBothPossess: boolean
    regularSeasonTiesAllowed: boolean
    kickoffYardLine: int = 35
    touchbackYardLine: int
    patYardLine: int = 15
    clockStopsOnFirstDown: boolean (COLLEGE)
    oneFootInbounds: boolean (COLLEGE)
    hashFromSidelineFeet: double
    rosterMax: int = 53
    gameDayActives: int = 46
    practiceSquadMax: int = 16
    offseasonRosterMax: int «Q-7»
    irReturnsPerSeason: int «Q-7»
    irMinWeeks: int «Q-7»
  }
  class Club {
    id: UUID
    name: String
    shortName: String
    city: String
    conference: Conference
    division: Division
    logoKey: String
    primaryColor: String
    secondaryColor: String
    accentColor: String
    prestige: int
    reputationBoard: int
    reputationFans: int
    cash: long
    capSpace: long
    isUserControlled: boolean
    expectedWins: int
    scoutingLevel: int
    scoutingBudget: long
  }
  class Player {
    id: UUID
    name: String
    nationality: String
    college: String
    birthDate: LocalDate
    age: int
    heightCm: int
    weightKg: int
    position: Position (QB|RB|FB|WR|TE|LT|LG|C|RG|RT|DE|DT|OLB|MLB|CB|FS|SS|K|P|LS)
    unit: Unit (OFFENSE|DEFENSE|SPECIAL)
    attributes: PlayerAttributes
    overall: int «por posição, OVR v1»
    potential: int
    experienceYears: int
    rosterStatus: RosterStatus (ACTIVE|INACTIVE|PRACTICE_SQUAD|IR|PUP|FREE_AGENT|WAIVED)
    condition: int
    morale: int
    moraleFactors: JSON
    injury: Injury?
    suspensionWeeks: int
    contract: PlayerContract
    jerseyNumber: int
    isLegendary: boolean
    model3dUrl: String
  }
}
package "career" {
  class CareerSave {
    id: UUID
    name: String
    seed: long
    employmentStatus: EmploymentStatus
    currentWeek: int
    difficulty: Difficulty
    seasonMode: SeasonMode
    scoresPoints: int
    status: SaveStatus
    slot: int
    lastPlayedAt: Instant
  }
}
package "match" {
  class DepthChart {
    club: Club
    version: long
    updatedAt: Instant
    validated: boolean
  }
  class MatchSession {
    status: LiveStatus
    quarter: int
    clockSeconds: int
    playClockSeconds: int
    possession: Club
    down: int (1–4)
    distance: int
    ballOnAbsYd: int (0–100)
    homeScore: int
    awayScore: int
    timeoutsHome: int
    timeoutsAway: int
    seed: long
    rngCursor: long
    snapshotJson: TEXT
    decisionsLog: JSON
    version: long
  }
}
enum WorldKind {
  TEMPLATE  «database do jogo»
  SAVE  «dados da carreira»
}
class WorldCloner <<Service>> {
  clone(source, owner, kind, name): Cloned «@Transactional»
}
class CreateCareerUseCase <<UseCase>> {
  execute(userId, Command): CareerDto «@Transactional»
}
class AfterCommit <<Utility>> {
  run(what, action) «afterCommit»
  onRollback(what, undo)
}
class ForeignKeyPolicy <<Policy>> {
  CASCADE: filhos do save e do mundo
  RESTRICT: trilhas (consentimento, compra, carteira, ledger)
  SET NULL: referências opcionais
}
World "1" -- "*" League
World "1" -- "*" Club
World "1" -- "*" Player
League "1" -- "1" LeagueRules : «embedded»
Club "1" -- "0..53" Player : elenco ativo
Club "*" -- "*" Club : rivais da divisão
Club "1" -- "1" DepthChart
CareerSave "1" -- "1" World : mundo do save
CareerSave "*" -- "0..1" Club : franquia atual
CreateCareerUseCase ..> WorldCloner : usa
WorldCloner ..> World : TEMPLATE → SAVE
CreateCareerUseCase ..> CareerSave : cria
World ..> WorldKind : kind
ForeignKeyPolicy ..> CareerSave : CASCADE nos filhos
@enduml
