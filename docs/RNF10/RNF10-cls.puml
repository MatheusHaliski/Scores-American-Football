@startuml
title RNF10 — Notificações via Chrome (Web Push) · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "account" {
  class UserAccount {
    id: UUID
    email: String «AES-GCM»
    emailHash: String «unique»
    passwordHash: String «Argon2id»
    displayName: String
    locale: Locale
    role: Role
    status: AccountStatus
    failedLoginAttempts: int
    lockedUntil: Instant
    marketingConsent: boolean
    deletionRequestedAt: Instant
    profileVisibility: ProfileVisibility
    birthDate: LocalDate
    pendingEmail: String
  }
  class UserSettings {
    simQuarterMinutes: int
    playCallingLevel: PlayCallingLevel (KEY_MOMENTS|ALL_PLAYS|NONE)
    decisionTimeoutSeconds: int
    difficulty: Difficulty
    theme: ThemeMode
    highContrast: boolean
    fontScale: FontScale
    reducedMotion: boolean
    regionalFormat: String
    units: YardsOrMeters
    notificationsEnabled: boolean
  }
  class NotificationPreference {
    type: String
    enabled: boolean
  }
}
package "inbox" {
  class Notification {
    kind: String
    title: String
    body: String
    read: boolean
    createdAt: Instant «TTL 90d»
  }
}
class PushSubscription <<record>> {
  endpoint: String «unique»
  p256dh: String
  auth: String
  userAgent: String
  status: ACTIVE|REVOKED|FAILING
}
class NotificationDispatcher <<Service>> {
  dispatch(event)
  shouldPush(user, type): boolean
  collapse(user, type)
}
interface WebPushPort <<Port>> {
  send(subscription, payload, ttl): PushResult
}
UserAccount "1" -- "1" UserSettings : configurações
UserAccount "1" -- "*" NotificationPreference
UserAccount "1" -- "*" Notification
NotificationDispatcher ..> NotificationPreference : lê
NotificationDispatcher ..> PushSubscription : envia
NotificationDispatcher ..> WebPushPort : usa
NotificationDispatcher ..> Notification : cria
@enduml
