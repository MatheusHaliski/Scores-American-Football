@startuml
title RNF4 — JWT RSA, refresh rotativo em cookie __Host- · Diagrama de classes
skinparam classAttributeIconSize 0
hide empty methods
package "account" {
  class UserAccount {
    id: UUID
    email: String «AES-GCM»
    emailHash: String «unique»
    passwordHash: String «Argon2id»
    displayName: String
    locale: Locale
    role: Role
    status: AccountStatus
    failedLoginAttempts: int
    lockedUntil: Instant
    marketingConsent: boolean
    deletionRequestedAt: Instant
    profileVisibility: ProfileVisibility
    birthDate: LocalDate
    pendingEmail: String
  }
  class UserSession {
    id: UUID
    refreshTokenHash: String «cookie __Host-»
    ip: String
    userAgent: String
    expiresAt: Instant
    revokedAt: Instant
    replacedBy: UUID
  }
  class AuditLog {
    actor: String
    action: String
    resource: String
    resourceId: String
    result: String
    ip: String
    userAgent: String
    correlationId: String
    timestamp: Instant
  }
}
class TokenService <<Service>> {
  access(userId, roles, sid): IssuedToken «RS256, 15 min»
  refresh(): String «opaco 256 bits»
  hash(token): String «SHA-256»
}
class RefreshCookieWriter <<Helper>> {
  name = __Host-scores_af_rt
  HttpOnly · Secure · SameSite=Strict · Path=/ · sem Domain
  set(res, token, maxAge)
  clear(res)
}
class OriginCheckFilter <<Filter>> {
  doFilter: /auth/refresh e /auth/logout só same-origin()
}
class RefreshTokenUseCase <<UseCase>> {
  execute(refreshCookie, ip, userAgent): TokenPair «@Transactional»
}
interface UserSessionRepository <<Port>> {
  findByRefreshTokenHash(hash)
  revokeFamily(familyId)
  existsActiveFamily(familyId)
}
class SessionModule <<Frontend>> {
  accessToken: string «só memória»
  silentRefresh()
  onLogoutBroadcast()
}
UserAccount "1" -- "*" UserSession : sessões
RefreshTokenUseCase ..> UserSessionRepository : rotate / revokeFamily
RefreshTokenUseCase ..> TokenService : novo par
RefreshTokenUseCase ..> RefreshCookieWriter : Set-Cookie
RefreshTokenUseCase ..> UserSession : replacedBy
OriginCheckFilter ..> RefreshTokenUseCase : protege
SessionModule ..> RefreshTokenUseCase : refresh silencioso
@enduml
