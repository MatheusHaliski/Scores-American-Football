@startuml
title RNF4 — JWT RSA, refresh rotativo em cookie __Host- · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Visitante (não autenticado)" as c1
actor "Head coach / manager (usuário autenticado)" as c2
package "Frontend (Next.js)" as pkg_fe {
  component "SessionModule (access em memória)" as c3
  frame "componentes de SessionModule (access em memória)" as pkg_fe_sub {
    component "ApiClient (refresh único + fila)" as c4
    component "AuthPage" as c5
    component "SessionsList" as c6
    component "TabSync (BroadcastChannel)" as c7
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "AuthController" as c8
  component "AccountController" as c9
  component "RefreshCookieWriter" as c10
  component "OriginCheckFilter" as c11
  component "TokenService" as c12
  component "RsaKeyProvider" as c13
  component "SessionActiveFilter" as c14
  component "SecurityConfig" as c15
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "LoginUseCase" as c16
  component "RefreshTokenUseCase" as c17
  component "LogoutUseCase" as c18
  component "AccountUseCases" as c19
  component "AuditService" as c20
}
package "portas (port.out)" as pkg_ports {
  interface "UserAccountRepository" as c21
  interface "UserSessionRepository" as c22
  interface "SessionCachePort" as c23
  interface "AuditLogRepository" as c24
  interface "SecretsPort" as c25
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c26
  component "cache-redis" as c27
  component "secrets-cofre" as c28
}
database "MySQL 8" as s1
database "Redis 7" as s2
database "Cofre de segredos do provedor (Railway Variables / GitHub Secrets)" as s3
c1 --> c3 : usa
c2 --> c3 : usa
c3 --> c8 : POST /auth/login (alvo)\nPOST /auth/refresh (alvo)\nPOST /auth/logout (alvo)\n…
c3 --> c9
c3 --> c10
c3 --> c11
c3 --> c12
c3 --> c13
c3 --> c14
c3 --> c15
c8 --> c16
c9 --> c16
c10 --> c16
c11 --> c16
c12 --> c16
c13 --> c16
c14 --> c16
c15 --> c16
c16 ..> pkg_app : orquestra
pkg_app --> pkg_ports : depende (DIP)
c26 .up.|> c21
c26 .up.|> c22
c27 .up.|> c23
c26 .up.|> c24
c28 .up.|> c25
c26 --> s1
c27 --> s2
c28 --> s3
@enduml
