@startuml
title RNF7 — Auditoria e registro de atividades (logging) · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
actor "Administrador" as c2
actor "Agendador/Job assíncrono" as c3
package "Frontend (Next.js)" as pkg_fe {
  component "ActivitySection" as c4
  frame "componentes de ActivitySection" as pkg_fe_sub {
    component "AdminAuditPage" as c5
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "CorrelationIdFilter" as c6
  component "AuditContextFilter" as c7
  component "ClientIpResolver" as c8
  component "ProblemDetailWriter" as c9
  component "AdminAuditController" as c10
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "AuditService" as c11
  component "AuditActions" as c12
  component "LogSafe" as c13
  component "ActivityUseCases" as c14
  component "QueryAuditLogUseCase" as c15
  component "AuditRetentionJob" as c16
}
package "portas (port.out)" as pkg_ports {
  interface "AuditLogRepository" as c17
  interface "CounterPort" as c18
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c19
  component "cache-redis" as c20
}
database "MySQL 8" as s1
database "Redis 7" as s2
c1 --> c4 : usa
c2 --> c4 : usa
c3 --> c11 : dispara
c4 --> c6 : GET /me/activity\nPOST /auth/login\nPOST /careers/{id}/weeks/current/play\n…
c4 --> c7
c4 --> c8
c4 --> c9
c4 --> c10
c6 --> c11
c7 --> c11
c8 --> c11
c9 --> c11
c10 --> c11
c11 ..> pkg_app : orquestra
pkg_app --> pkg_ports : depende (DIP)
c19 .up.|> c17
c20 .up.|> c18
c19 --> s1
c20 --> s2
@enduml
