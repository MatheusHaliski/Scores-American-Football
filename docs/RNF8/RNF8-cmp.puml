@startuml
title RNF8 — Privacidade e conformidade com a LGPD · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
actor "Agendador/Job assíncrono" as c2
actor "Administrador" as c3
package "Frontend (Next.js)" as pkg_fe {
  component "PrivacySection" as c4
  frame "componentes de PrivacySection" as pkg_fe_sub {
    component "ConsentToggles" as c5
    component "ExportDataCard" as c6
    component "DeleteAccountDialog" as c7
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "AccountController" as c8
  component "PrivacyController" as c9
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "AccountUseCases" as c10
  component "PrivacyUseCases" as c11
  component "DataExportUseCases" as c12
  component "AccountDeletionUseCases" as c13
  component "PasswordAttemptGuard" as c14
  component "AuditService" as c15
}
package "portas (port.out)" as pkg_ports {
  interface "UserAccountRepository" as c16
  interface "UserSessionRepository" as c17
  interface "ConsentRecordRepository" as c18
  interface "DataExportJobRepository" as c19
  interface "MediaStoragePort" as c20
  interface "SessionCachePort" as c21
  interface "TimelinePort" as c22
  interface "EmailPort" as c23
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c24
  component "storage-s3" as c25
  component "cache-redis" as c26
  component "persistence-cassandra" as c27
}
database "MySQL 8" as s1
database "S3/MinIO" as s2
database "Redis 7" as s3
database "Cassandra 4.1" as s4
c1 --> c4 : usa
c2 --> c10 : dispara
c3 --> c4 : usa
c4 --> c8 : GET /me\nPUT /me/consents\nPOST /me/export\n…
c4 --> c9
c8 --> c10
c9 --> c10
c10 ..> pkg_app : orquestra
pkg_app --> pkg_ports : depende (DIP)
c24 .up.|> c16
c24 .up.|> c17
c24 .up.|> c18
c24 .up.|> c19
c25 .up.|> c20
c26 .up.|> c21
c27 .up.|> c22
c24 --> s1
c25 --> s2
c26 --> s3
c27 --> s4
@enduml
