@startuml
title RNF9 — Desempenho e usabilidade da interface (3D com 22 atletas) · Diagrama de componentes
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 36
actor "Head coach / manager (usuário autenticado)" as c1
package "Frontend (Next.js)" as pkg_fe {
  component "AppShell" as c2
  frame "componentes de AppShell" as pkg_fe_sub {
    component "FieldScene3D (lazy)" as c3
    component "AthleteInstances (22, LOD)" as c4
    component "Field2DFallback" as c5
    component "FpsGovernor" as c6
    component "MotionProvider" as c7
    component "ApiClientWithETag" as c8
    component "OfflineBanner" as c9
  }
}
package "scores-af-web (REST)" as pkg_web {
  component "AccountController" as c10
  component "CareerController" as c11
  component "MatchController" as c12
  component "EtagFilter" as c13
}
package "scores-af-application (casos de uso)" as pkg_app {
  component "GetUserSettingsUseCase" as c14
  component "GetClubDashboardUseCase" as c15
  component "GetMatchEventsUseCase" as c16
  component "GetPlayFormationUseCase" as c17
  component "CacheAsidePolicy" as c18
}
package "portas (port.out)" as pkg_ports {
  interface "UserSettingsRepository" as c19
  interface "SessionCachePort" as c20
  interface "LiveMatchStatePort" as c21
  interface "TimelinePort" as c22
  interface "MediaStoragePort" as c23
}
package "adaptadores (scores-af-infrastructure, D-8)" as pkg_ad {
  component "persistence-mysql" as c24
  component "cache-redis" as c25
  component "persistence-cassandra" as c26
  component "storage-s3" as c27
}
database "MySQL 8" as s1
database "Redis 7" as s2
database "Cassandra 4.1" as s3
database "S3/MinIO" as s4
c1 --> c2 : usa
c2 --> c10 : GET /me/settings\nGET /careers/{id}/dashboard\nGET /matches/{mid}/events (alvo)\n…
c2 --> c11
c2 --> c12
c2 --> c13
c10 --> c14
c11 --> c14
c12 --> c14
c13 --> c14
c14 ..> pkg_app : orquestra
pkg_app --> pkg_ports : depende (DIP)
c24 .up.|> c19
c25 .up.|> c20
c25 .up.|> c21
c26 .up.|> c22
c27 .up.|> c23
c24 --> s1
c25 --> s2
c26 --> s3
c27 --> s4
@enduml
