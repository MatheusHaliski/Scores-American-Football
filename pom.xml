<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>br.com.velion.scoresaf</groupId>
  <artifactId>scores-american-football</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Scores: American Football</name>
  <description>Gerente de futebol americano da VELION TECH CO. — mesma arquitetura do Scores (basquete), domínio próprio (docs/01).</description>

  <!-- Infraestrutura entra no bloco em que cada adaptador ganha o primeiro uso (D-8): persistence-mysql no bloco 3;
       cache-redis, persistence-cassandra, search-opensearch, storage-s3 e ai-providers depois. -->
  <modules>
    <module>scores-af-domain</module>
    <module>scores-af-application</module>
    <module>scores-af-infrastructure</module>
    <module>scores-af-web</module>
    <module>scores-af-bootstrap</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <springdoc.version>3.1.1</springdoc.version>
    <bouncycastle.version>1.86</bouncycastle.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>br.com.velion.scoresaf</groupId><artifactId>scores-af-domain</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>br.com.velion.scoresaf</groupId><artifactId>scores-af-application</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>br.com.velion.scoresaf</groupId><artifactId>scores-af-persistence-mysql</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>br.com.velion.scoresaf</groupId><artifactId>scores-af-web</artifactId><version>${project.version}</version></dependency>
      <!-- Argon2id (spring-security-crypto) usa o Bouncy Castle -->
      <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>${bouncycastle.version}</version></dependency>
      <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>${springdoc.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
            <!-- processador explícito: a partir do JDK 23 o javac não roda processadores achados só no classpath -->
            <annotationProcessorPaths>
              <path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>${lombok.version}</version></path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- testes de integração com Testcontainers exigem Docker e rodam só no perfil "it" -->
            <excludedGroups>it</excludedGroups>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <!-- combine.self="override": um <excludedGroups/> vazio é mesclado com o "it" do pluginManagement e não tira a
                 exclusão (era o que acontecia com a configuração copiada do basquete: -Pit não rodava nenhum teste it) -->
            <configuration><excludedGroups combine.self="override"/></configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
